rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isValidProject(data) {
      return data.keys().hasAll(['name', 'status', 'createdAt', 'updatedAt', 'version'])
          && data.name is string && data.name.size() <= 200
          && (data.get('description', null) == null || (data.description is string && data.description.size() <= 2000))
          && (data.get('color', null) == null || (data.color is string && data.color.size() <= 50))
          && (data.get('icon', null) == null || (data.icon is string && data.icon.size() <= 50))
          && data.status in ['active', 'completed', 'archived']
          && data.createdAt is number
          && data.updatedAt is number
          && data.version is number
          && (data.get('deletedAt', null) == null || data.deletedAt is number)
          && (data.get('_conflicts', null) == null || (data._conflicts is list && data._conflicts.size() <= 10));
    }

    function isValidNote(data) {
      return data.keys().hasAll(['title', 'content', 'tags', 'pinned', 'archived', 'favorite', 'createdAt', 'updatedAt', 'version'])
          && data.title is string && data.title.size() <= 200
          && data.content is string && data.content.size() <= 50000
          && data.tags is list && data.tags.size() <= 20
          && data.pinned is bool
          && data.archived is bool
          && data.favorite is bool
          && (data.get('driveFileIds', null) == null || (data.driveFileIds is list && data.driveFileIds.size() <= 50))
          && (data.get('projectId', null) == null || (data.projectId is string && data.projectId.size() <= 128))
          && data.createdAt is number
          && data.updatedAt is number
          && data.version is number
          && (data.get('deletedAt', null) == null || data.deletedAt is number)
          && (data.get('_conflicts', null) == null || (data._conflicts is list && data._conflicts.size() <= 10));
    }

    function isValidTask(data) {
      return data.keys().hasAll(['title', 'notes', 'completed', 'dueDate', 'priority', 'tags', 'createdAt', 'updatedAt', 'version'])
          && data.title is string && data.title.size() <= 200
          && data.notes is string && data.notes.size() <= 10000
          && data.completed is bool
          && (data.dueDate == null || data.dueDate is number)
          && data.priority in ['none', 'low', 'medium', 'high']
          && data.tags is list && data.tags.size() <= 20
          && (data.get('projectId', null) == null || (data.projectId is string && data.projectId.size() <= 128))
          && (data.get('relatedNoteId', null) == null || (data.relatedNoteId is string && data.relatedNoteId.size() <= 128))
          && (data.get('relatedEventId', null) == null || (data.relatedEventId is string && data.relatedEventId.size() <= 128))
          && data.createdAt is number
          && data.updatedAt is number
          && data.version is number
          && (data.get('deletedAt', null) == null || data.deletedAt is number)
          && (data.get('_conflicts', null) == null || (data._conflicts is list && data._conflicts.size() <= 10));
    }

    function isValidEvent(data) {
      return data.keys().hasAll(['title', 'description', 'startTime', 'endTime', 'allDay', 'location', 'recurrenceRule', 'reminders', 'provider', 'createdAt', 'updatedAt', 'version'])
          && data.title is string && data.title.size() <= 200
          && data.description is string && data.description.size() <= 10000
          && data.startTime is number
          && data.endTime is number
          && data.allDay is bool
          && data.location is string && data.location.size() <= 500
          && (data.recurrenceRule == null || (data.recurrenceRule is string && data.recurrenceRule.size() <= 500))
          && data.reminders is list && data.reminders.size() <= 10
          && data.provider in ['local', 'google']
          && (data.get('providerEventId', null) == null || (data.providerEventId is string && data.providerEventId.size() <= 256))
          && (data.get('projectId', null) == null || (data.projectId is string && data.projectId.size() <= 128))
          && data.createdAt is number
          && data.updatedAt is number
          && data.version is number
          && (data.get('deletedAt', null) == null || data.deletedAt is number)
          && (data.get('_conflicts', null) == null || (data._conflicts is list && data._conflicts.size() <= 10));
    }

    function isValidClipboard(data) {
      return data.keys().hasAll(['content', 'contentType', 'pinned', 'favorite', 'createdAt', 'updatedAt', 'version'])
          && data.content is string && data.content.size() <= 5000000
          && data.contentType in ['text', 'url', 'code', 'image']
          && data.pinned is bool
          && data.favorite is bool
          && (data.get('source', null) == null || (data.source is string && data.source.size() <= 200))
          && (data.get('projectId', null) == null || (data.projectId is string && data.projectId.size() <= 128))
          && data.createdAt is number
          && data.updatedAt is number
          && data.version is number
          && (data.get('deletedAt', null) == null || data.deletedAt is number)
          && (data.get('_conflicts', null) == null || (data._conflicts is list && data._conflicts.size() <= 10));
    }

    function isValidPreference(data, id) {
      return data.keys().hasAll(['createdAt', 'updatedAt', 'version'])
          && data.createdAt is number
          && data.updatedAt is number
          && data.version is number
          && (data.get('id', null) == null || (data.id is string && data.id == id))
          && (data.get('deletedAt', null) == null || data.deletedAt is number)
          && (data.get('_conflicts', null) == null || (data._conflicts is list && data._conflicts.size() <= 10))
          && (
             (id == 'app_settings' && data.keys().hasAll(['theme', 'weatherUnit', 'calendarDefaultView', 'calendarWeekStart'])
                && data.theme in ['system', 'light', 'dark']
                && data.weatherUnit in ['celsius', 'fahrenheit']
                && data.calendarDefaultView in ['month', 'week', 'day', 'agenda']
                && data.calendarWeekStart in ['sunday', 'monday']
                && (data.get('manualLat', null) == null || data.manualLat is number)
                && (data.get('manualLon', null) == null || data.manualLon is number)
             )
             ||
             (id == 'dashboard' && data.keys().hasAll(['widgetVisibility', 'widgetOrder'])
                && data.widgetVisibility is map
                && data.widgetOrder is map
             )
          );
    }

    function isValidVaultMeta(data) {
      return data.keys().hasAll(['id', 'vaultVersion', 'kdf', 'evk', 'createdAt', 'updatedAt', 'version'])
          && data.keys().hasOnly(['id', 'vaultVersion', 'kdf', 'evk', 'createdAt', 'updatedAt', 'deletedAt', 'version', '_conflicts', 'syncStatus', 'syncError'])
          && data.id is string && data.id.size() <= 64
          && data.vaultVersion is number && data.vaultVersion == 1
          && data.kdf is map
          && data.kdf.algorithm == 'PBKDF2'
          && data.kdf.hash == 'SHA-256'
          && data.kdf.iterations >= 100000
          && data.kdf.salt is string && data.kdf.salt.size() <= 128
          && data.evk is map
          && data.evk.encryptedVaultKey is string && data.evk.encryptedVaultKey.size() <= 512
          && data.evk.evkIv is string && data.evk.evkIv.size() <= 64
          && data.createdAt is number
          && data.updatedAt is number
          && data.version is number
          && (data.get('deletedAt', null) == null || data.deletedAt is number)
          && (data.get('_conflicts', null) == null || (data._conflicts is list && data._conflicts.size() <= 10));
    }

    function isValidVaultItem(data) {
      // STRICT ZERO KNOWLEDGE: Plaintext fields (password, username, title, notes, url) are strictly forbidden
      return data.keys().hasAll(['id', 'vaultVersion', 'schemaVersion', 'iv', 'ciphertext', 'createdAt', 'updatedAt', 'version'])
          && data.keys().hasOnly(['id', 'vaultVersion', 'schemaVersion', 'iv', 'ciphertext', 'createdAt', 'updatedAt', 'deletedAt', 'version', '_conflicts', 'syncStatus', 'syncError'])
          && data.id is string && data.id.size() <= 128
          && data.vaultVersion is number && data.vaultVersion == 1
          && data.schemaVersion is number && data.schemaVersion == 1
          && data.iv is string && data.iv.size() <= 64
          && data.ciphertext is string && data.ciphertext.size() <= 65536
          && data.createdAt is number
          && data.updatedAt is number
          && data.version is number
          && (data.get('deletedAt', null) == null || data.deletedAt is number)
          && (data.get('_conflicts', null) == null || (data._conflicts is list && data._conflicts.size() <= 10));
    }

    match /users/{userId} {
      match /projects/{projectId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn() 
                      && request.auth.uid == userId
                      && isValidId(projectId)
                      && isValidProject(incoming())
                      && incoming().keys().size() <= 14;
        allow update: if isSignedIn() 
                      && request.auth.uid == userId
                      && isValidId(projectId)
                      && isValidProject(incoming())
                      && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'color', 'icon', 'status', 'updatedAt', 'deletedAt', 'version', '_conflicts'])
                      && incoming().createdAt == existing().createdAt;
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }

      match /notes/{noteId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn() 
                      && request.auth.uid == userId
                      && isValidId(noteId)
                      && isValidNote(incoming())
                      && incoming().keys().size() <= 15;
        allow update: if isSignedIn() 
                      && request.auth.uid == userId
                      && isValidId(noteId)
                      && isValidNote(incoming())
                      && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'content', 'tags', 'pinned', 'archived', 'favorite', 'driveFileIds', 'projectId', 'updatedAt', 'deletedAt', 'version', '_conflicts'])
                      && incoming().createdAt == existing().createdAt;
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }

      match /tasks/{taskId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn() 
                      && request.auth.uid == userId
                      && isValidId(taskId)
                      && isValidTask(incoming())
                      && incoming().keys().size() <= 16;
        allow update: if isSignedIn() 
                      && request.auth.uid == userId
                      && isValidId(taskId)
                      && isValidTask(incoming())
                      && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'notes', 'completed', 'dueDate', 'priority', 'tags', 'projectId', 'relatedNoteId', 'relatedEventId', 'updatedAt', 'deletedAt', 'version', '_conflicts'])
                      && incoming().createdAt == existing().createdAt;
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }

      match /events/{eventId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn() 
                      && request.auth.uid == userId
                      && isValidId(eventId)
                      && isValidEvent(incoming())
                      && incoming().keys().size() <= 17;
        allow update: if isSignedIn() 
                      && request.auth.uid == userId
                      && isValidId(eventId)
                      && isValidEvent(incoming())
                      && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'startTime', 'endTime', 'allDay', 'location', 'recurrenceRule', 'reminders', 'providerEventId', 'projectId', 'updatedAt', 'deletedAt', 'version', '_conflicts'])
                      && incoming().createdAt == existing().createdAt;
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }

      match /clipboard/{clipboardId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn() 
                      && request.auth.uid == userId
                      && isValidId(clipboardId)
                      && isValidClipboard(incoming())
                      && incoming().keys().size() <= 12;
        allow update: if isSignedIn() 
                      && request.auth.uid == userId
                      && isValidId(clipboardId)
                      && isValidClipboard(incoming())
                      && incoming().diff(existing()).affectedKeys().hasOnly(['content', 'contentType', 'pinned', 'favorite', 'source', 'projectId', 'updatedAt', 'deletedAt', 'version', '_conflicts'])
                      && incoming().createdAt == existing().createdAt;
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }

      match /preferences/{preferenceId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn() 
                      && request.auth.uid == userId
                      && (preferenceId == 'app_settings' || preferenceId == 'dashboard')
                      && isValidPreference(incoming(), preferenceId)
                      && incoming().keys().size() <= 14;
        allow update: if isSignedIn() 
                      && request.auth.uid == userId
                      && (preferenceId == 'app_settings' || preferenceId == 'dashboard')
                      && isValidPreference(incoming(), preferenceId)
                      && incoming().diff(existing()).affectedKeys().hasOnly(['id', 'theme', 'weatherUnit', 'calendarDefaultView', 'calendarWeekStart', 'manualLat', 'manualLon', 'widgetVisibility', 'widgetOrder', 'updatedAt', 'deletedAt', 'version', '_conflicts'])
                      && incoming().createdAt == existing().createdAt;
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }

      
      match /folders/{folderId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create, update, delete: if isSignedIn() && request.auth.uid == userId;
      }
      match /files/{fileId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create, update, delete: if isSignedIn() && request.auth.uid == userId;
      }
      match /vault_meta/{metaId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn() 
                      && request.auth.uid == userId
                      && isValidId(metaId)
                      && isValidVaultMeta(incoming())
                      && incoming().keys().size() <= 11;
        allow update: if isSignedIn() 
                      && request.auth.uid == userId
                      && isValidId(metaId)
                      && isValidVaultMeta(incoming())
                      && incoming().diff(existing()).affectedKeys().hasOnly(['vaultVersion', 'kdf', 'evk', 'updatedAt', 'deletedAt', 'version', '_conflicts', 'syncStatus', 'syncError'])
                      && incoming().createdAt == existing().createdAt;
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }

      match /vault_items/{itemId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn() 
                      && request.auth.uid == userId
                      && isValidId(itemId)
                      && isValidVaultItem(incoming())
                      && incoming().keys().size() <= 12;
        allow update: if isSignedIn() 
                      && request.auth.uid == userId
                      && isValidId(itemId)
                      && isValidVaultItem(incoming())
                      && incoming().diff(existing()).affectedKeys().hasOnly(['vaultVersion', 'schemaVersion', 'iv', 'ciphertext', 'updatedAt', 'deletedAt', 'version', '_conflicts', 'syncStatus', 'syncError'])
                      && incoming().createdAt == existing().createdAt;
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }

      // Explicit conceptual /users/{userId}/vault/... hierarchy support
      match /vault/config/{metaId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn() 
                      && request.auth.uid == userId
                      && isValidId(metaId)
                      && isValidVaultMeta(incoming())
                      && incoming().keys().size() <= 11;
        allow update: if isSignedIn() 
                      && request.auth.uid == userId
                      && isValidId(metaId)
                      && isValidVaultMeta(incoming())
                      && incoming().diff(existing()).affectedKeys().hasOnly(['vaultVersion', 'kdf', 'evk', 'updatedAt', 'deletedAt', 'version', '_conflicts', 'syncStatus', 'syncError'])
                      && incoming().createdAt == existing().createdAt;
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }

      match /vault/items/{itemId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn() 
                      && request.auth.uid == userId
                      && isValidId(itemId)
                      && isValidVaultItem(incoming())
                      && incoming().keys().size() <= 12;
        allow update: if isSignedIn() 
                      && request.auth.uid == userId
                      && isValidId(itemId)
                      && isValidVaultItem(incoming())
                      && incoming().diff(existing()).affectedKeys().hasOnly(['vaultVersion', 'schemaVersion', 'iv', 'ciphertext', 'updatedAt', 'deletedAt', 'version', '_conflicts', 'syncStatus', 'syncError'])
                      && incoming().createdAt == existing().createdAt;
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }

      match /vault/{vaultId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow write: if isSignedIn() && request.auth.uid == userId && (isValidVaultMeta(incoming()) || isValidVaultItem(incoming()));
      }
    }
  }
}
