{
  "entities": {
    "Note": {
      "title": "Note",
      "description": "A text note",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 200 },
        "content": { "type": "string", "maxLength": 50000 },
        "tags": { "type": "array", "items": { "type": "string", "maxLength": 50 }, "maxLength": 20 },
        "pinned": { "type": "boolean" },
        "archived": { "type": "boolean" },
        "favorite": { "type": "boolean" },
        "driveFileIds": { "type": "array", "items": { "type": "string", "maxLength": 100 }, "maxLength": 50 },
        "projectId": { "type": ["string", "null"], "maxLength": 128 },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" },
        "deletedAt": { "type": ["number", "null"] },
        "version": { "type": "number" },
        "_conflicts": { "type": "array", "maxLength": 10 }
      },
      "required": ["title", "content", "tags", "pinned", "archived", "favorite", "createdAt", "updatedAt", "version"]
    },
    "Task": {
      "title": "Task",
      "description": "A to-do item",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 2000 },
        "completed": { "type": "boolean" },
        "dueDate": { "type": ["number", "null"] },
        "projectId": { "type": ["string", "null"], "maxLength": 128 },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" },
        "deletedAt": { "type": ["number", "null"] },
        "version": { "type": "number" },
        "_conflicts": { "type": "array", "maxLength": 10 }
      },
      "required": ["title", "completed", "createdAt", "updatedAt", "version"]
    },
    "CalendarEvent": {
      "title": "CalendarEvent",
      "description": "A scheduled event",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 200 },
        "startTime": { "type": "number" },
        "endTime": { "type": "number" },
        "allDay": { "type": "boolean" },
        "location": { "type": "string", "maxLength": 500 },
        "recurrenceRule": { "type": ["string", "null"], "maxLength": 500 },
        "reminders": { "type": "array", "items": { "type": "number" }, "maxLength": 10 },
        "provider": { "type": "string" },
        "providerEventId": { "type": ["string", "null"], "maxLength": 256 },
        "projectId": { "type": ["string", "null"], "maxLength": 128 },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" },
        "deletedAt": { "type": ["number", "null"] },
        "version": { "type": "number" },
        "_conflicts": { "type": "array", "maxLength": 10 }
      },
      "required": ["title", "startTime", "endTime", "allDay", "createdAt", "updatedAt", "version"]
    },
    "VaultMeta": {
      "title": "VaultMeta",
      "description": "Encrypted vault configuration and KDF parameters (zero knowledge, no master password or keys)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "vaultVersion": { "type": "number" },
        "kdf": {
          "type": "object",
          "properties": {
            "algorithm": { "type": "string" },
            "hash": { "type": "string" },
            "iterations": { "type": "number" },
            "salt": { "type": "string", "maxLength": 128 }
          },
          "required": ["algorithm", "hash", "iterations", "salt"]
        },
        "evk": {
          "type": "object",
          "properties": {
            "encryptedVaultKey": { "type": "string", "maxLength": 512 },
            "evkIv": { "type": "string", "maxLength": 64 }
          },
          "required": ["encryptedVaultKey", "evkIv"]
        },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" },
        "deletedAt": { "type": ["number", "null"] },
        "version": { "type": "number" },
        "_conflicts": { "type": "array", "maxLength": 10 }
      },
      "required": ["id", "vaultVersion", "kdf", "evk", "createdAt", "updatedAt", "version"]
    },
    "VaultItem": {
      "title": "VaultItem",
      "description": "Encrypted password vault item (zero knowledge, no plaintext title, username, password, notes, or URL)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "vaultVersion": { "type": "number" },
        "schemaVersion": { "type": "number" },
        "iv": { "type": "string", "maxLength": 64 },
        "ciphertext": { "type": "string", "maxLength": 65536 },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" },
        "deletedAt": { "type": ["number", "null"] },
        "version": { "type": "number" },
        "_conflicts": { "type": "array", "maxLength": 10 }
      },
      "required": ["id", "vaultVersion", "schemaVersion", "iv", "ciphertext", "createdAt", "updatedAt", "version"]
    },
    "Project": {
      "title": "Project",
      "description": "A workspace grouping notes, tasks, events, and files",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 2000 },
        "color": { "type": ["string", "null"], "maxLength": 50 },
        "icon": { "type": ["string", "null"], "maxLength": 50 },
        "status": { "type": "string", "enum": ["active", "completed", "archived"] },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" },
        "deletedAt": { "type": ["number", "null"] },
        "version": { "type": "number" },
        "_conflicts": { "type": "array", "maxLength": 10 }
      },
      "required": ["name", "status", "createdAt", "updatedAt", "version"]
    }
  },
  "firestore": {
    "/users/{userId}/projects/{projectId}": {
      "schema": { "$ref": "#/entities/Project" },
      "description": "User projects"
    },
    "/users/{userId}/notes/{noteId}": {
      "schema": { "$ref": "#/entities/Note" },
      "description": "User notes"
    },
    "/users/{userId}/tasks/{taskId}": {
      "schema": { "$ref": "#/entities/Task" },
      "description": "User tasks"
    },
    "/users/{userId}/events/{eventId}": {
      "schema": { "$ref": "#/entities/CalendarEvent" },
      "description": "User calendar events"
    },
    "/users/{userId}/vault_meta/{metaId}": {
      "schema": { "$ref": "#/entities/VaultMeta" },
      "description": "Encrypted vault configuration"
    },
    "/users/{userId}/vault_items/{itemId}": {
      "schema": { "$ref": "#/entities/VaultItem" },
      "description": "Encrypted vault item records"
    },
    "/users/{userId}/vault/config/{metaId}": {
      "schema": { "$ref": "#/entities/VaultMeta" },
      "description": "Encrypted vault configuration (conceptual path)"
    },
    "/users/{userId}/vault/items/{itemId}": {
      "schema": { "$ref": "#/entities/VaultItem" },
      "description": "Encrypted vault item records (conceptual path)"
    }
  }
}
